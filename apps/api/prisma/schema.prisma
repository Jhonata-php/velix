generator client {
  provider = "prisma-client-js"

  // "native" é detectado em tempo de `prisma generate`, e a imagem de build
  // (node:20-bookworm-slim) não traz o binário do OpenSSL — sem ele o Prisma
  // não consegue ler a versão e cai no chute "debian-openssl-1.1.x", que não
  // existe no Bookworm. O runtime então quebra em PrismaClientInitializationError
  // ("could not locate the Query Engine for debian-openssl-3.0.x"). Declarar o
  // alvo explicitamente tira a detecção do caminho crítico.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  /// Segredo TOTP, cifrado. Só existe depois que o usuário confirma um código —
  /// guardar antes deixaria contas em estado meio-ativado, onde o app já mostra
  /// códigos mas o login não os exige.
  totpSecretEnc     String?
  totpEnabledAt     DateTime?
  /// Códigos de recuperação, guardados como hash. Perder o celular não pode
  /// significar perder o painel.
  recoveryCodesHash String[]  @default([])

  sessions     UserSession[]
  resetTokens  PasswordResetToken[]
}

// Uma linha por login bem-sucedido — o JWT carrega `sid` apontando pra cá.
// Revogar (revokedAt) derruba o acesso mesmo com um JWT ainda "válido" na
// assinatura/expiração, o que é o que permite: logout de um dispositivo
// específico, logout de todas as sessões, e invalidar tudo após redefinir
// senha. Sem isso, um JWT vazado continuaria valendo até expirar sozinho.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// Token de "esqueci minha senha" — só o hash SHA-256 é gravado; o valor bruto
// existe apenas no link enviado por e-mail e nunca toca o banco ou os logs.
// Uso único (usedAt) e expiração curta (~30min); uma nova solicitação invalida
// qualquer token anterior do mesmo usuário (ver PasswordRecoveryService).
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  requestedIp String?
  userAgent   String?

  @@index([userId, createdAt])
}

// Trilha de auditoria de segurança mais ampla que LoginAttempt (que só cobre
// tentativas de login) — cobre todo o ciclo de recuperação/redefinição de
// senha e sessão. `userId` fica nulo quando o evento não tem um usuário real
// associado (ex.: recuperação pedida pra um e-mail que não existe) — sem
// revelar isso na resposta ao cliente, só no registro interno.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  event     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// Trilha de auditoria de login — nunca grava a senha, só o desfecho.
// Consultada pelo `velix doctor` e por telas futuras de segurança/admin.
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Histórico de verificações de atualização (tela "Atualizações"). Cada
// consulta à API de Releases do GitHub — manual ou por polling — grava uma
// linha aqui. Não representa o ciclo de vida de uma instalação de atualização
// (isso é a fase seguinte, ainda não implementada); é só o registro de "o que
// a gente viu, e quando".
model UpdateCheck {
  id              String    @id @default(uuid())
  checkedAt       DateTime  @default(now())
  installedVersion String
  latestVersion   String?
  channel         String    @default("stable")
  updateAvailable Boolean   @default(false)
  releaseUrl      String?
  publishedAt     DateTime?
  // Populado quando a consulta ao GitHub falha (rate limit, token inválido,
  // repositório privado sem acesso, rede) — o registro existe mesmo assim
  // pra a tela mostrar "última tentativa falhou" em vez de nada.
  error           String?

  @@index([checkedAt])
}

/// Atualizações de fato aplicadas — não é a mesma coisa que UpdateCheck, que só
/// registra consultas ao GitHub. Gravado no start da API quando a versão do
/// arquivo VERSION difere da última conhecida: esse é exatamente o momento em
/// que a troca terminou, e é o único sinal confiável, já que a atualização
/// acontece fora do painel (instalador rodando por SSH).
model UpdateEvent {
  id          String   @id @default(uuid())
  appliedAt   DateTime @default(now())
  fromVersion String?
  toVersion   String
  /// Quem rodou o instalador — o install.sh grava SUDO_USER no .env. Fica
  /// "desconhecido" se a atualização foi feita por fora dele.
  appliedBy   String   @default("desconhecido")

  @@index([appliedAt])
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
  ERROR
}

enum AuthMethod {
  PASSWORD
  PRIVATE_KEY
}

// ponytail: uma conta ativa por instalação (o serviço usa a mais recente).
// Virar tabela multi-conta de verdade quando existir mais de um token/zona
// isolado por equipe ou provedor.
model CloudflareAccount {
  id           String   @id @default(uuid())
  email        String?
  apiTokenEnc  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Server {
  id            String       @id @default(uuid())
  name          String
  description   String?
  /// Servidor onde o próprio Velix roda. Registrado automaticamente pelo
  /// instalador (ver LocalServerService): o painel fala com o host por SSH,
  /// pelo mesmo caminho de qualquer servidor remoto — nada de caminho especial
  /// no motor de implantação. Não pode ser removido pelo usuário, porque
  /// voltaria a ser criado no próximo start da API.
  isLocal       Boolean      @default(false)
  publicIp      String?
  privateIp     String?
  hostname      String?
  sshPort       Int          @default(22)
  sshUser       String
  authMethod    AuthMethod   @default(PASSWORD)
  // ponytail: credencial única cifrada com AES-256-GCM (ver ssh/crypto.util.ts).
  // Rotação de chave por servidor e Vault externo entram quando houver mais de um operador confiável.
  credentialEnc String
  status        ServerStatus @default(PENDING)
  osName        String?
  osVersion     String?
  packageManager String?
  dockerInstalled Boolean    @default(false)
  dockerVersion String?
  // ponytail: colunas do EasyPanel mantidas só pra não quebrar a leitura de
  // servidores já cadastrados (migração segura — etapa 1). Nenhum fluxo novo
  // escreve nelas; some da experiência via frontend. Dropar só quando não
  // houver mais nenhuma linha com easypanelInstalled=true.
  easypanelInstalled Boolean @default(false)
  easypanelUrl  String?
  // Proxy reverso nativo do Velix (substitui o EasyPanel como plataforma).
  traefikInstalled Boolean  @default(false)
  traefikVersion String?
  // Estado da plataforma Velix no servidor: NOT_PREPARED | PREPARING | READY | DEGRADED | ERROR
  platformState String      @default("NOT_PREPARED")
  metrics       Json?
  metricsCheckedAt DateTime?
  lastCheckedAt DateTime?
  tags          String[]     @default([])
  environment   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  databaseInstances DatabaseInstance[]
  metricSamples ServerMetricSample[]
  mirrorAsSource ServerMirror?  @relation("MirrorSource")
  mirrorsAsTarget ServerMirror[] @relation("MirrorTarget")
  domains       Domain[]
  applications  Application[]
}

enum DomainStatus {
  PENDING   // criado, ainda não verificado/roteando
  ACTIVE    // roteando e respondendo em HTTPS
  ERROR     // falha ao emitir certificado ou registrar DNS
}

// Domínio roteado pelo Traefik do servidor. `applicationId` é opcional: um
// domínio pode apontar pra uma porta solta (fase anterior) ou pra uma
// aplicação implantada pelo Velix — quando a aplicação existe, o Traefik
// roteia pro nome do container na rede velix-proxy em vez do host.
model Domain {
  id                 String       @id @default(uuid())
  serverId           String
  server             Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  applicationId      String?
  application        Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  hostname           String       @unique
  // Nome do serviço (dentro da aplicação) que recebe a rota — null pras portas soltas da fase anterior.
  serviceName        String?
  targetPort         Int
  createDnsRecord    Boolean      @default(true)
  cloudflareRecordId String?
  cloudflareZoneId   String?
  status             DomainStatus @default(PENDING)
  lastError          String?
  lastCheckedAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([serverId])
}

enum ApplicationStatus {
  /// Projeto recém-criado, ainda sem nenhum serviço implantado dentro dele.
  EMPTY
  DEPLOYING
  RUNNING
  STOPPED
  ERROR
  REMOVING
}

enum ApplicationEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  LAB
}

// Projeto do Velix: um diretório com UM docker-compose.yml no servidor
// (`docker compose -p <slug>`), que pode reunir serviços implantados de
// origens diferentes — cada implantação (manifesto do catálogo ou repositório
// Git) vira uma linha em `ProjectDeployment`; o compose gravado no servidor é
// o merge de todas elas (ver `mergeComposeFragments`). Nasce vazio
// (status EMPTY) e ganha serviços conforme o usuário implanta dentro dele.
model Application {
  id               String            @id @default(uuid())
  serverId         String
  server           Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name             String
  slug             String            @unique
  description      String?
  environment      ApplicationEnvironment @default(PRODUCTION)
  tags             String[]          @default([])
  status           ApplicationStatus @default(EMPTY)
  // Compose efetivamente aplicado no servidor — merge de todas as
  // `ProjectDeployment` do projeto. Vazio enquanto o projeto não tem nenhum
  // serviço. Guardado (e não só regenerado on-the-fly) pra permitir
  // diff/rollback quando essa feature existir.
  composeRendered  String            @default("")
  containerNames   String[]          @default([])
  lastError        String?
  deployedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  domains          Domain[]
  services         ProjectService[]
  deployments      ProjectDeployment[]

  @@index([serverId])
}

/// Uma implantação — de UM manifesto do catálogo ou de UM repositório Git —
/// dentro de um projeto. Um projeto pode ter várias (ex.: seu app via Git +
/// um Postgres avulso do catálogo, lado a lado no mesmo `Application`).
model ProjectDeployment {
  id               String      @id @default(uuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// "catalog" (manifesto curado) ou "git" (repositório do usuário). O motor de
  /// implantação é o mesmo dali pra frente — muda só como a imagem nasce:
  /// puxada de um registro ou construída no servidor a partir do código.
  sourceType       String      @default("catalog")
  /// Só para sourceType="catalog".
  manifestSlug     String?
  manifestVersion  String?
  // Nomes dos serviços opcionais do manifesto que o usuário escolheu incluir —
  // os obrigatórios não precisam estar aqui (sempre implícitos). Junto de
  // manifestSlug, é o que permite reconfigurar o compose ao adicionar um
  // serviço novo depois do deploy inicial.
  selectedServices String[]    @default([])
  // Compose renderizado só desta implantação (não o do projeto inteiro) —
  // guardado pra `removeService`/`addService` conseguirem recompor o merge
  // sem precisar re-renderizar todas as outras implantações do projeto a
  // partir do manifesto delas de novo.
  composeRendered  String      @default("")
  // Segredos gerados no deploy (ex.: senha de banco), cifrados como um blob JSON —
  // mesmo padrão AES-256-GCM já usado pra credenciais SSH/Cloudflare.
  secretsEnc       String?
  // Valores de `{{var:...}}` resolvidos no deploy (não sensíveis — texto puro).
  // Reaproveitado ao adicionar um serviço depois, senão o compose recalculado
  // voltaria os valores pro padrão do manifesto e recriaria os containers já
  // no ar com uma configuração diferente da que o usuário escolheu.
  variablesJson    String?
  /// Só para sourceType="git". A URL fica em claro (não é segredo); o token de
  /// acesso, quando existe, é cifrado à parte.
  repoUrl          String?
  gitRef           String?
  /// "dockerfile" ou "nixpacks".
  buildMethod      String?
  dockerfilePath   String?
  /// Token de acesso a repositório privado, cifrado com AES-256-GCM — mesmo
  /// padrão das credenciais SSH. Nunca volta em nenhuma resposta da API.
  /// Preenchido quando o usuário digita um token avulso; quando ele escolhe uma
  /// conta salva, o token vem de `gitAccount`.
  repoTokenEnc     String?
  gitAccountId     String?
  gitAccount       GitAccount? @relation(fields: [gitAccountId], references: [id], onDelete: SetNull)
  /// Reimplantar sozinho quando chegar um push na branch acompanhada.
  autoDeploy       Boolean     @default(false)
  /// Segredo do webhook — é ele que autentica a chamada vinda da forja, já que
  /// não há sessão de usuário nesse caminho. Único por implantação: vazar um
  /// não dá acesso a redeployar as outras.
  webhookSecret    String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  services         ProjectService[]

  @@index([applicationId])
}

/// Conta de forja Git salva em Configurações, para não digitar o mesmo token a
/// cada implantação. O token é cifrado com AES-256-GCM (mesmo padrão das
/// credenciais SSH) e nunca volta em nenhuma resposta da API — a tela mostra
/// só o rótulo e os últimos caracteres, o suficiente pra identificar qual é.
model GitAccount {
  id       String  @id @default(uuid())
  label    String
  host     String  @default("github.com")
  username String?

  /// "token" (Personal Access Token colado à mão) ou "github_app" (App
  /// auto-registrado via manifest — só disponível pra host="github.com").
  authMethod String @default("token")

  /// Só para authMethod="token".
  tokenEnc String?
  /// Últimos 4 caracteres, em claro, só para exibição. Só para authMethod="token".
  tokenHint String?

  /// Campos de authMethod="github_app" — todos nulos pras contas de token.
  githubAppId    String?
  githubAppSlug  String?
  installationId String?
  /// JSON cifrado com clientId/clientSecret/privateKeyPem/webhookSecret —
  /// mesmo padrão AES-256-GCM de blob JSON já usado em
  /// ProjectDeployment.secretsEnc/AlertChannel.configEnc.
  credentialsEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployments ProjectDeployment[]
}

/// Destino de notificação. O `config` é cifrado porque carrega URL de webhook
/// (que é segredo — quem a tem posta no canal) e token de bot.
model AlertChannel {
  id        String   @id @default(uuid())
  label     String
  /// discord | telegram | webhook
  type      String
  configEnc String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries AlertDelivery[]
}

/// Uma linha por alerta enviado. Existe por dois motivos: mostrar histórico e,
/// principalmente, evitar reenvio — sem isso a checagem a cada 5 minutos
/// repetiria "disco cheio" 288 vezes por dia até alguém agir, e o canal viraria
/// ruído que ninguém mais lê.
model AlertDelivery {
  id         String       @id @default(uuid())
  channelId  String
  channel    AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Identidade do problema, não do envio: "server-offline:<id>". Reenvia só
  /// quando o estado se resolve e volta a acontecer.
  fingerprint String
  title      String
  body       String
  ok         Boolean      @default(true)
  error      String?
  sentAt     DateTime     @default(now())

  @@index([fingerprint, sentAt])
}

/// Estado atual de cada condição monitorada, para saber quando ela abre e quando
/// fecha. Sem isso não há como mandar "voltou ao normal", que é metade do valor
/// de um alerta.
model AlertState {
  fingerprint String   @id
  openedAt    DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
}

/// Backup do banco do Velix e do .env. Uma linha por execução — o histórico é o
/// que permite saber que o agendamento parou de rodar, coisa que um arquivo
/// solto no disco não conta.
model BackupRun {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// RUNNING | SUCCESS | ERROR
  status      String    @default("RUNNING")
  /// "scheduled" ou "manual" — distinguir importa pra diagnosticar agendamento.
  trigger     String    @default("scheduled")
  fileName    String?
  sizeBytes   Int?
  error       String?

  @@index([startedAt])
}

/// Bloqueio de conta por tentativas falhas. Separado de LoginAttempt (que é
/// trilha de auditoria, append-only) porque aqui o estado é mutável e
/// consultado a cada login.
model AccountLock {
  email       String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

enum ProjectServiceStatus {
  DEPLOYING
  RUNNING
  STOPPED
  ERROR
}

// Um componente (container) dentro de um projeto — o projeto (Application)
// deixa de ser um container isolado e passa a ter vários desses, cada um
// com ciclo de vida próprio (iniciar/parar/reiniciar individualmente).
model ProjectService {
  id              String                @id @default(uuid())
  applicationId   String
  application     Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // De qual implantação (manifesto ou repo Git) este container veio — decide
  // que abas mostrar na tela do serviço (ex.: "Fonte" só existe pra Git) e
  // permite achar o manifesto certo pra "adicionar serviço opcional".
  deploymentId    String
  deployment      ProjectDeployment     @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  // Nome do serviço dentro do compose (ex.: "app", "db", "onlyoffice") — igual
  // ao `name` declarado no VelixManifestService de origem.
  name            String
  image           String
  containerName   String
  required        Boolean               @default(true)
  status          ProjectServiceStatus  @default(DEPLOYING)
  // Porta do host publicada pra este container (ex.: pra conectar um cliente
  // de banco de fora) — null enquanto não publicada. Só a porta muda; a
  // porta DENTRO do container é sempre a mesma do manifesto.
  publishedPort   Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  backupConfig    DatabaseBackupConfig?
  backupRuns      DatabaseBackupRun[]

  @@unique([applicationId, name])
  @@index([applicationId])
  @@index([deploymentId])
}

/// Conexão FTP/SFTP salva pra onde um backup de banco pode ser enviado —
/// configurada uma vez em Configurações, reaproveitável por vários bancos
/// (mesmo padrão de GitAccount pra contas de forja).
model BackupDestination {
  id            String   @id @default(uuid())
  label         String
  /// "ftp" | "sftp"
  protocol      String
  host          String
  port          Int
  username      String
  /// Cifrado com o mesmo padrão AES-256-GCM já usado em GitAccount/Server.
  credentialEnc String
  remotePath    String   @default("/")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  backupConfigs DatabaseBackupConfig[]
}

/// Agendamento de backup de UM banco (ProjectService) — 1:1, cada banco tem
/// no máximo uma configuração.
model DatabaseBackupConfig {
  id               String   @id @default(uuid())
  projectServiceId String   @unique
  projectService   ProjectService @relation(fields: [projectServiceId], references: [id], onDelete: Cascade)

  /// "HH:mm" (fuso do servidor da API) — null = sem agendamento automático, só manual.
  scheduledAt      String?
  retentionDays    Int      @default(14)

  destinationId    String?
  destination      BackupDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Histórico de execuções de backup de um banco — mesmo padrão do BackupRun
/// já usado pro backup do próprio Velix (apps/api/prisma/schema.prisma, model BackupRun).
model DatabaseBackupRun {
  id               String   @id @default(uuid())
  projectServiceId String
  projectService   ProjectService @relation(fields: [projectServiceId], references: [id], onDelete: Cascade)

  /// "scheduled" | "manual"
  trigger          String
  /// "RUNNING" | "SUCCESS" | "ERROR"
  status           String
  fileName         String?
  sizeBytes        Int?
  uploadedRemote   Boolean  @default(false)
  error            String?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?

  @@index([projectServiceId])
}

// ponytail: um espelho por servidor de origem (1 destino) — cobre o caso
// pedido (A -> B automático). Fan-out pra vários destinos vira modelo
// many-to-many quando surgir um caso real de mais de um espelho por origem.
model ServerMirror {
  id             String   @id @default(uuid())
  sourceServerId String   @unique
  sourceServer   Server   @relation("MirrorSource", fields: [sourceServerId], references: [id], onDelete: Cascade)
  targetServerId String
  targetServer   Server   @relation("MirrorTarget", fields: [targetServerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

// ponytail: uma amostra por coleta (~10s de intervalo no front), podada pra
// manter só os últimos 7 dias — sem job de limpeza separado, a poda roda
// junto de cada inserção.
model ServerMetricSample {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  loadAvg1    Float?
  memUsedMb   Int?
  memTotalMb  Int?
  diskPercent Float?
  capturedAt  DateTime @default(now())

  @@index([serverId, capturedAt])
}

enum DbEngine {
  MYSQL
}

enum DbRole {
  STANDALONE
  PRIMARY
  REPLICA
}

enum DbInstanceStatus {
  PENDING
  ONLINE
  OFFLINE
  ERROR
}

// ponytail: todo banco instalado pelo Velix já nasce com binlog/GTID
// habilitados (server-id, log-bin, gtid-mode=ON) — evita o passo separado de
// "reconfigurar o primário depois" do spec original. Simplifica o fluxo de
// criação de réplica ao custo de uma flag a mais no `docker run` sempre ligada.
model DatabaseInstance {
  id              String            @id @default(uuid())
  serverId        String
  server          Server            @relation(fields: [serverId], references: [id])
  name            String
  engine          DbEngine          @default(MYSQL)
  containerName   String
  port            Int
  mysqlServerId   Int
  role            DbRole            @default(STANDALONE)
  status          DbInstanceStatus  @default(PENDING)
  version         String?
  databaseName    String
  appUser         String
  appPasswordEnc  String
  rootPasswordEnc String
  lastCheckedAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  replicationsAsPrimary DatabaseReplication[] @relation("PrimaryInstance")
  replicationAsReplica  DatabaseReplication?  @relation("ReplicaInstance")
}

enum ReplicationStatus {
  PROVISIONING
  SYNCING
  IN_SYNC
  DELAYED
  ERROR
  PROMOTED
}

model DatabaseReplication {
  id                     String             @id @default(uuid())
  primaryInstanceId      String
  primaryInstance        DatabaseInstance   @relation("PrimaryInstance", fields: [primaryInstanceId], references: [id])
  replicaInstanceId      String             @unique
  replicaInstance        DatabaseInstance   @relation("ReplicaInstance", fields: [replicaInstanceId], references: [id])
  replicationUser        String
  replicationPasswordEnc String
  status                 ReplicationStatus  @default(PROVISIONING)
  secondsBehind          Int?
  lastError              String?
  lastCheckedAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}
