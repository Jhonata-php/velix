{
  "name": "@velix/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "postbuild": "node -e \"if(!require('fs').existsSync('dist/main.js')){console.error('✗ Build verification failed: dist/main.js not found');process.exit(1)}console.log('✓ Build verified: dist/main.js exists')\"",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "admin:reset-password": "node scripts/reset-admin-password.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.20.0",
    "basic-ftp": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "marked": "^12.0.2",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "prisma": "^5.20.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.16.0",
    "ssh2": "^1.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
