# Copie para .env e ajuste antes de subir em produção.
# Só a porta 3000 (painel) precisa ficar acessível — a API não é mais exposta
# diretamente, o Next.js proxeia /api/* internamente (ver next.config.js).
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-aleatorio
VELIX_CREDENTIAL_SECRET=troque-por-outro-segredo-aleatorio
WEB_ORIGIN=http://SEU_IP:3000
VELIX_ADMIN_EMAIL=admin@velix.local
VELIX_ADMIN_PASSWORD=troque-esta-senha

# Centro de Atualizações — consulta a API de Releases do GitHub. Nenhum é
# obrigatório: sem UPDATE_GITHUB_TOKEN funciona em repositório público, com
# limite de 60 requisições/hora (cache interno de 10min já poupa a maioria).
# UPDATE_REPO_OWNER=Jhonata-php
# UPDATE_REPO_NAME=velix
# UPDATE_GITHUB_TOKEN=
# UPDATE_CHANNEL=stable
